{
  "manifest_version": 3,
  "name": "悬浮标 · 网页端",
  "version": "0.1.0",
  "description": "把悬浮标的消息送进 ChatGPT / Gemini 网页端，并把生成进度回报给桌面悬浮窗。",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/adapters.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "悬浮标"
  }
}
